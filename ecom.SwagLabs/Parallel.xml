<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SwagLabs Parallel Suite"
       parallel="classes"
       thread-count="5">

    <test name="Login Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="login1.loginTest"/>
        </classes>
    </test>

    <test name="Product Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="product.productTest"/>
        </classes>
    </test>

    <test name="Cart Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="cart.cartTest1"/>
        </classes>
    </test>

    <test name="Checkout Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="checkout.CheckoutTest"/>
        </classes>
    </test>

    <test name="Hamburger Menu Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="hamburgerMenu.HamburgerMenuTest"/>
        </classes>
    </test>

</suite>


